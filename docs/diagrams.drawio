<diagram id="hotel-context-map" name="Context map">
  <mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#f5fafc">
    <root>
