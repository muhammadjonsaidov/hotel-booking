      <mxCell id="title" value="Hotel business context map" style="html=1;whiteSpace=wrap;fontColor=#173650;fontSize=18;strokeColor=#173650;text;align=left;fontStyle=1;fontSize=26;" vertex="1" parent="1">
        <mxGeometry as="geometry" x="50" y="30" width="1250" height="50" />
      </mxCell>
      <mxCell id="rooms" value="&lt;b&gt;Rooms (Inventory)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Keeps room numbers, types and nightly prices.&lt;br&gt;Status: in service / out of service.&lt;br&gt;Owns the room catalog, prices and sale availability." style="html=1;whiteSpace=wrap;fontColor=#173650;fontSize=18;strokeColor=#173650;rounded=0;strokeWidth=2;align=left;verticalAlign=top;spacing=22;fillColor=#ffffff;" vertex="1" parent="1">
        <mxGeometry as="geometry" x="80" y="150" width="480" height="220" />
      </mxCell>
      <mxCell id="payments" value="&lt;b&gt;Payments&lt;/b&gt;&lt;br&gt;&lt;br&gt;Keeps deposits and their amounts.&lt;br&gt;Status: Paid / Declined.&lt;br&gt;Owns deposit calculation and refund rules." style="html=1;whiteSpace=wrap;fontColor=#173650;fontSize=18;strokeColor=#173650;rounded=0;strokeWidth=2;align=left;verticalAlign=top;spacing=22;fillColor=#ffffff;" vertex="1" parent="1">
        <mxGeometry as="geometry" x="840" y="150" width="480" height="220" />
      </mxCell>
      <mxCell id="reservations" value="&lt;b&gt;Reservations&lt;/b&gt;&lt;br&gt;&lt;br&gt;Keeps guests, stays and reservation ids.&lt;br&gt;Status: Confirmed / Cancelled.&lt;br&gt;Owns the rule: no two Confirmed reservations of one room share a night." style="html=1;whiteSpace=wrap;fontColor=#173650;fontSize=18;strokeColor=#173650;rounded=0;strokeWidth=2;align=left;verticalAlign=top;spacing=22;fillColor=#d5e8d4;strokeColor=#3d7542;" vertex="1" parent="1">
        <mxGeometry as="geometry" x="80" y="620" width="480" height="240" />
      </mxCell>
      <mxCell id="notifications" value="&lt;b&gt;Notifications&lt;/b&gt;&lt;br&gt;&lt;br&gt;Keeps confirmation messages and channels.&lt;br&gt;Status: Sent / Failed.&lt;br&gt;Owns email/SMS delivery; failure never changes a reservation." style="html=1;whiteSpace=wrap;fontColor=#173650;fontSize=18;strokeColor=#173650;rounded=0;strokeWidth=2;align=left;verticalAlign=top;spacing=22;fillColor=#ffffff;" vertex="1" parent="1">
